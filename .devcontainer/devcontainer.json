{
  "name": "Kinova Teleop ROS2 Jazzy (Podman)",
  "build": {
    "dockerfile": "../container/Containerfile",
    "context": ".."
  },
  "runArgs": [
    "--network=host",
    "--ipc=host"
  ],
  "workspaceFolder": "/workspaces/kinova-teleoperation",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/kinova-teleoperation,type=bind,Z",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-iot.vscode-ros",
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "ms-python.python"
      ]
    }
  },
  "postCreateCommand": "bash -lc 'source /opt/ros/jazzy/setup.bash && ./scripts/setup_colcon_ws.sh && rosdep update || true'"
}
